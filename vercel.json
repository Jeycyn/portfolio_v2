{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(data|\\.env|node_modules|\\.git|\\.aistudio|.*\\.sqlite|.*\\.db)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
